{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "9a783e49f2b341889152df299a6cc6d0",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "UVtoOctahedron (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -699.9999389648438,
            "y": 772.7999877929688,
            "width": 251.19998168945313,
            "height": 277.59991455078127
        }
    },
    "m_Slots": [
        {
            "m_Id": "c29b6e5833e34a38b187d457d9c1c0a5"
        },
        {
            "m_Id": "1a879f50c03a44ce9dd272fd82b53255"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "UVtoOctahedron",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// float3 UVtoOctahedron(float2 uv) {\r\n    // Unpack the 0...1 range to the -1...1 unit square.\r\n    position = float3(2.0f * (uv - 0.5f), 0);                \r\n\r\n    // \"Lift\" the middle of the square to +1 z, and let it fall off linearly\r\n    // to z = 0 along the Manhattan metric diamond (absolute.x + absolute.y == 1),\r\n    // and to z = -1 at the corners where position.x and .y are both = +-1.\r\n    float2 absolute = abs(position.xy);\r\n    position.z = 1.0f - absolute.x - absolute.y;\r\n\r\n    // \"Tuck in\" the corners by reflecting the xy position along the line y = 1 - x\r\n    // (in quadrant 1), and its mirrored image in the other quadrants.\r\n    if(position.z < 0) {\r\n        position.xy = sign(position.xy) \r\n                    * float2(1.0f - absolute.y, 1.0f - absolute.x);\r\n    }\r\n\r\n    //return position;\r\n//}"
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.DynamicValueMaterialSlot",
